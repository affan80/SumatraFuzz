diff --git a/sf_private_namespace.h b/sf_private_namespace.h
new file mode 100644
index 0000000..ebd8765
--- /dev/null
+++ b/sf_private_namespace.h
@@ -0,0 +1,105 @@
+/* SumatraFuzz: narrow IPC compatibility for the pinned Windows x64 worker.
+ * The supervisor owns the namespace. Never create it or widen the token here. */
+#ifndef SF_PRIVATE_NAMESPACE_H
+#define SF_PRIVATE_NAMESPACE_H
+#include <windows.h>
+#include <sddl.h>
+#include <string.h>
+#pragma comment(lib, "advapi32.lib")
+
+typedef struct {
+  char alias[42];
+  char run_sid[128];
+  DWORD worker_sid[SECURITY_MAX_SID_SIZE / sizeof(DWORD)];
+  PSID restricted_sid;
+  HANDLE namespace_handle;
+  DWORD acl[256];
+  SECURITY_DESCRIPTOR descriptor;
+} SF_NAMESPACE;
+static SF_NAMESPACE sf_namespace;
+
+static void sf_fail(void) {
+  /* No token, SID, command line or paths in diagnostics. */
+  OutputDebugStringA("SF_IPC_NAMESPACE_FAILURE");
+  TerminateProcess(GetCurrentProcess(), 130);
+  ExitProcess(130);
+}
+
+static void *sf_token_info(HANDLE token, TOKEN_INFORMATION_CLASS kind) {
+  DWORD size = 0;
+  void *data;
+  GetTokenInformation(token, kind, NULL, 0, &size);
+  if (!size || size > 65536) sf_fail();
+  data = HeapAlloc(GetProcessHeap(), HEAP_ZERO_MEMORY, size);
+  if (!data || !GetTokenInformation(token, kind, data, size, &size)) sf_fail();
+  return data;
+}
+
+static void sf_namespace_init(SF_NAMESPACE *ns, const char *alias_option,
+                              const char *sid_option) {
+  DWORD length, i;
+  HANDLE token;
+  TOKEN_USER *user;
+  TOKEN_GROUPS *restricted;
+  BOOL found = FALSE;
+  SID_IDENTIFIER_AUTHORITY authority = {{0x53,0x46,0x57,0x52,0x4b,0x31}};
+  LPSTR canonical = NULL;
+  HANDLE boundary;
+  length = GetEnvironmentVariableA("SUMATRAFUZZ_NAMESPACE_ALIAS", ns->alias, sizeof(ns->alias));
+  if (length != 41 || memcmp(ns->alias, "SFWR-", 5)) sf_fail();
+  for (i = 5; i < 41; ++i) {
+    char c = ns->alias[i];
+    if (i == 13 || i == 18 || i == 23 || i == 28) {
+      if (c != '-') sf_fail();
+    } else if (!((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') ||
+                 (c >= 'A' && c <= 'F'))) sf_fail();
+  }
+  length = GetEnvironmentVariableA("SUMATRAFUZZ_RUN_SID", ns->run_sid, sizeof(ns->run_sid));
+  if (!length || length >= sizeof(ns->run_sid)) sf_fail();
+  if ((alias_option && strcmp(alias_option, ns->alias)) ||
+      (sid_option && strcmp(sid_option, ns->run_sid))) sf_fail();
+  if (!ConvertStringSidToSidA(ns->run_sid, &ns->restricted_sid) ||
+      !IsValidSid(ns->restricted_sid) ||
+      memcmp(GetSidIdentifierAuthority(ns->restricted_sid), &authority, sizeof(authority)) ||
+      *GetSidSubAuthorityCount(ns->restricted_sid) != 3 ||
+      !ConvertSidToStringSidA(ns->restricted_sid, &canonical) ||
+      lstrcmpiA(canonical, ns->run_sid)) sf_fail();
+  LocalFree(canonical);
+  if (!OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token)) sf_fail();
+  user = (TOKEN_USER *)sf_token_info(token, TokenUser);
+  restricted = (TOKEN_GROUPS *)sf_token_info(token, TokenRestrictedSids);
+  for (i = 0; i < restricted->GroupCount; ++i)
+    if (EqualSid(ns->restricted_sid, restricted->Groups[i].Sid)) found = TRUE;
+  if (!found || !CopySid(sizeof(ns->worker_sid), ns->worker_sid, user->User.Sid)) sf_fail();
+  HeapFree(GetProcessHeap(), 0, user);
+  HeapFree(GetProcessHeap(), 0, restricted);
+  CloseHandle(token);
+  boundary = CreateBoundaryDescriptorA(ns->alias, 0);
+  if (!boundary || !AddSIDToBoundaryDescriptor(&boundary, ns->worker_sid)) sf_fail();
+  ns->namespace_handle = OpenPrivateNamespaceA(boundary, ns->alias);
+  DeleteBoundaryDescriptor(boundary);
+  if (!ns->namespace_handle) sf_fail();
+}
+
+static void sf_security(SF_NAMESPACE *ns, SECURITY_ATTRIBUTES *sa, DWORD rights) {
+  PACL acl = (PACL)ns->acl;
+  if (!InitializeAcl(acl, sizeof(ns->acl), ACL_REVISION) ||
+      !AddAccessAllowedAce(acl, ACL_REVISION, rights, ns->worker_sid) ||
+      !AddAccessAllowedAce(acl, ACL_REVISION, rights, ns->restricted_sid) ||
+      !InitializeSecurityDescriptor(&ns->descriptor, SECURITY_DESCRIPTOR_REVISION) ||
+      !SetSecurityDescriptorDacl(&ns->descriptor, TRUE, acl, FALSE) ||
+      !SetSecurityDescriptorControl(&ns->descriptor, SE_DACL_PROTECTED, SE_DACL_PROTECTED)) sf_fail();
+  sa->nLength = sizeof(*sa);
+  sa->lpSecurityDescriptor = &ns->descriptor;
+  sa->bInheritHandle = FALSE;
+}
+
+static void sf_namespace_name(SF_NAMESPACE *ns, const char *object,
+                               char *output, size_t capacity) {
+  size_t a = strlen(ns->alias), n = strlen(object);
+  if (!n || strchr(object, '\\') || strchr(object, '/') || a + 1 + n >= capacity) sf_fail();
+  memcpy(output, ns->alias, a);
+  output[a] = '\\';
+  memcpy(output + a + 1, object, n + 1);
+}
+#endif
